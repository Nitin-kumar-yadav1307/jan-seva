# -------------------------
# API Server
# -------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# -------------------------
# Database (MongoDB)
# -------------------------
# In local development, if MongoDB URI is empty or unavailable, in-memory/mock fallback handles queries
MONGODB_URI=mongodb://127.0.0.1:27017/coopseva

# -------------------------
# Authentication
# -------------------------
JWT_SECRET=coopseva_super_secret_jwt_key_sih_2026_prototype
JWT_EXPIRES_IN=7d

# -------------------------
# AI Engine
# -------------------------
# Set AI_MODE to 'demo' for reliable mock AI, or 'api' when using OpenAI/Gemini
AI_MODE=demo
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# -------------------------
# Maps Provider
# -------------------------
MAP_PROVIDER=mapbox
MAP_API_KEY=
MAP_MODE=demo

# -------------------------
# Payments (Razorpay Sandbox)
# -------------------------
RAZORPAY_KEY_ID=rzp_test_mockKeyId12345
RAZORPAY_KEY_SECRET=mockSecretKey67890
PAYMENT_MODE=test

# -------------------------
# Realtime & Sockets
# -------------------------
SOCKET_ORIGIN=http://localhost:5173
