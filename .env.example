# -------------------------
# API Server
# -------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# -------------------------
# Database (MongoDB)
# -------------------------
# In local development, if MongoDB URI is empty or unavailable, in-memory/mock fallback handles queries
MONGODB_URI=

# -------------------------
# Authentication
# -------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# -------------------------
# AI Engine
# -------------------------
# Set AI_MODE to 'demo' for reliable mock AI, or 'api' when using OpenAI/Gemini
AI_MODE=demo
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# -------------------------
# Maps Provider (OpenStreetMap + Leaflet)
# -------------------------
MAP_PROVIDER=openstreetmap
MAP_API_KEY=
MAP_MODE=live

# -------------------------
# Payments (Razorpay Sandbox)
# -------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MODE=test

# -------------------------
# Realtime & Sockets
# -------------------------
SOCKET_ORIGIN=http://localhost:5173
