# -------------------------
# API Server
# -------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:5173

# -------------------------
# Database (MongoDB)
# -------------------------
# In local development, if MongoDB URI is empty or unavailable, in-memory/mock fallback handles queries
# REQUIRED in production
MONGODB_URI=

# -------------------------
# Authentication
# -------------------------
# REQUIRED (non-empty) in production — server refuses to boot without it
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Set to 'true' to create demo accounts / seed demo data (never enable in production)
DEMO_ACCOUNTS_ENABLED=

# -------------------------
# AI Engine
# -------------------------
# Set AI_MODE to 'demo' for reliable mock AI, or 'api' when using OpenAI/Gemini
AI_MODE=demo
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# -------------------------
# Maps Provider (OpenStreetMap + Leaflet)
# -------------------------
MAP_PROVIDER=openstreetmap
MAP_API_KEY=
MAP_MODE=live

# -------------------------
# Payments (Razorpay)
# -------------------------
Razorpay test keys from https://dashboard.razorpay.com/app/keys (use live keys + PAYMENT_MODE=live in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MODE=test

# -------------------------
# Realtime & Sockets
# -------------------------
SOCKET_ORIGIN=http://localhost:5173

